<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <packaging>jar</packaging>

    <parent>
        <artifactId>hkex-cmdb-sync</artifactId>
        <groupId>com.cloudwise</groupId>
        <version>1.0.6</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hkex-cmdb-sync-server</artifactId>
    <name>hkex-cmdb-sync-server</name>
    <description>主服务：ServiceNow 取数、DOUC 写入、定时调度</description>

    <dependencies>
        <dependency>
            <groupId>com.cloudwise</groupId>
            <artifactId>hkex-cmdb-sync-common</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudwise.douc</groupId>
            <artifactId>douc-sdk-core</artifactId>
            <version>${douc.sdk.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.apache.dubbo</groupId>
            <artifactId>dubbo-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudwise.architecture</groupId>
            <artifactId>cwop-commons</artifactId>
            <version>3.1.0</version>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.42</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>

        <!--
          inf-bom 在 spring-boot-starter-web 上排除了 spring-boot-starter-logging，
          Cloudwise 全线统一用 log4j2（docc 同款做法）。这里补回日志门面与实现，
          否则 org.slf4j 不在类路径上，所有 @Slf4j 类编译失败。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>

        <!-- APIM 应用鉴权的签名算法：SM3（默认），也支持 md5/sha256。版本由 inf-bom 管理。 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
        </dependency>

        <!-- 定时任务，与 docc 用同一套 XXL-Job。版本由 inf-bom 管理。 -->
        <dependency>
            <groupId>com.xuxueli</groupId>
            <artifactId>xxl-job-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- 本地只发布引导配置；完整应用配置在 Nacos，仅 SN 用户名和密码为密文。 -->
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*.example</exclude>
                    <exclude>application.yml</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>conf</directory>
                <includes>
                    <include>application.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!--
              运行期配置放在 conf/ 而不是 src/main/resources：conf/ 由 bin/hkexCmdbSync
              挂到 classpath 上，改配置不需要重新打包。
              测试要保持同样的加载位置，所以把 conf/ 也挂到测试类路径上，
              并指定 dev profile（prod 配的是真实生产地址，测试跑不了）。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.basedir}/conf</additionalClasspathElement>
                    </additionalClasspathElements>
                    <systemPropertyVariables>
                        <spring.profiles.active>dev</spring.profiles.active>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!--
              制品打包：thin jar + lib/ 全依赖，打成 tar.gz。
              与 docc / doop-server 同一形态，CI 的 .build_template 直接产出该 tar 包。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>${maven-assembly-plugin.version}</version>
                <configuration>
                    <appendAssemblyId>false</appendAssemblyId>
                    <tarLongFileMode>gnu</tarLongFileMode>
                </configuration>
                <executions>
                    <execution>
                        <id>make-service-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/assembly.xml</descriptor>
                            </descriptors>
                            <finalName>${final-tar-name}</finalName>
                        </configuration>
                    </execution>
                    <execution>
                        <id>make-product-package</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/main/assembly/omp-product.xml</descriptor>
                            </descriptors>
                            <finalName>${omp.product.name}-${project.version}-${build.time}-install</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
