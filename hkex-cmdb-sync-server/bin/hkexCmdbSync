#!/bin/bash
#
# hkex-cmdb-sync 服务启停脚本。
#
# 形态与 docc / doop-server 一致：把 conf/ 挂到 classpath 上（排在 lib/ 之前），
# 所以改配置只要重启，不需要重新打包。
#
# 用法：
#   ./bin/hkexCmdbSync start            后台启动，默认 prod 配置
#   ./bin/hkexCmdbSync start -f         前台启动，直接看日志
#   ./bin/hkexCmdbSync stop | restart | status
#   SPRING_PROFILE=dev ./bin/hkexCmdbSync start
#
# 未经部署工具安装时用 -l（local）模式：以脚本上级目录为服务目录，
# 日志写 <包根>/logs，pid 写 <包根>/pid，profile 默认 dev，解压即用。
#   ./bin/hkexCmdbSync start -l -f

CURRENT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
THIS_SCRIPT="$CURRENT_DIR/$(basename "$0")"
PACKAGE_HOME=$(cd "${CURRENT_DIR}/.." &>/dev/null && pwd)

# OMP 安装脚本生成的运行参数。文件只包含目录、端口、运行用户和内存，权限 0600。
# 非 OMP 部署没有该文件，继续走下方原有的 CW_* 占位符逻辑。
OMP_ENV_FILE="${PACKAGE_HOME}/conf/omp.env"
test -f "${OMP_ENV_FILE}" && . "${OMP_ENV_FILE}"

######### 服务名 主类
# 各服务独自维护 #
# APP_NAME 为服务名，与服务目录保持一致
APP_NAME="hkexCmdbSync"
# 服务主类
MAIN_CLASS="com.cloudwise.cmdb.CmdbSyncApplication"
# SpringProfile：留空表示由 -l 或下面的默认值决定
SPRING_PROFILE="${SPRING_PROFILE:-}"
######### END

######### JVM HEAP SIZE #########
# ${CW_JVM_HEAP_SIZE} 占位符，由部署工具替换
# 若环境变量中声明了 ENV_JVM_HEAP_SIZE 则使用环境变量中的值，带单位
INNER_JVM_HEAP_SIZE_MIN="${CW_JVM_HEAP_SIZE}"
INNER_JVM_HEAP_SIZE_MAX="${CW_JVM_HEAP_SIZE}"
######### END

######### 内部变量 部署时自动替换占位符 部署完成后若调整需手动修改变量后面的值
INNER_RUN_USER="${CW_RUN_USER}"
INNER_LOCAL_IP="${CW_LOCAL_IP}"
INNER_APP_DIR="${CW_INSTALL_APP_DIR}"
INNER_LOG_DIR="${CW_INSTALL_LOGS_DIR}"
INNER_DATA_DIR="${CW_INSTALL_DATA_DIR}"
INNER_SERVICE_PORT="${CW_SERVICE_PORT}"
INNER_METRICS_PORT="${CW_METRICS_PORT}"
INNER_XXLJOBEXE_PORT="${CW_XXLJOBEXE_PORT}"
INNER_NACOS_SERVER="${CW_NACOS_SERVER}"
INNER_NACOS_USERNAME="${CW_NACOS_USERNAME}"
INNER_NACOS_PASSWORD="${CW_NACOS_PASSWORD}"
INNER_NACOS_NAMESPACE="${CW_NACOS_NAMESPACE}"
######### END

# OMP 使用服务包的实际安装目录，不依赖旧部署器替换 CW_INSTALL_* 占位符。
[ -n "${OMP_RUN_USER:-}" ] && INNER_RUN_USER="${OMP_RUN_USER}"
[ -n "${OMP_SERVICE_PORT:-}" ] && INNER_SERVICE_PORT="${OMP_SERVICE_PORT}"

######### 参数解析：-l 本地模式，-f 前台
LOCAL_MODE=0
FOREGROUND=0
ACTION=""
for arg in "$@"; do
    case "$arg" in
    -l) LOCAL_MODE=1 ;;
    -f) FOREGROUND=1 ;;
    *) [ -z "$ACTION" ] && ACTION="$arg" ;;
    esac
done
######### END

######### 服务目录 通过内部变量自动解析
APP_HOME="${OMP_APP_HOME:-${INNER_APP_DIR}/${APP_NAME}}"
APP_LOG_DIR="${OMP_LOG_DIR:-${INNER_LOG_DIR}/${APP_NAME}}"
APP_PID_FILE="${APP_HOME}/${APP_NAME}.pid"
APP_CONF_DIR="${APP_HOME}/conf"
#########

######### 读取部署环境变量（部署工具生成，位于服务安装目录下）
test -f /etc/profile && . /etc/profile
test -f "${INNER_APP_DIR}/bash_profile" && . "${INNER_APP_DIR}/bash_profile"
source "${CURRENT_DIR}/java17.sh"
######### END

######### 本地模式：以脚本上级目录为服务目录，无需任何 CW_* 环境变量
if [ "${LOCAL_MODE}" -eq 1 ]; then
    APP_HOME="$(cd "${CURRENT_DIR}/.." &>/dev/null && pwd)"
    APP_CONF_DIR="${APP_HOME}/conf"
    APP_LOG_DIR="${APP_HOME}/logs"
    APP_PID_FILE="${APP_HOME}/pid/${APP_NAME}.pid"
    mkdir -p "${APP_LOG_DIR}" "${APP_HOME}/pid"
fi
# profile 默认值：本地模式用 dev（prod 配的是生产地址，本地跑不起来），部署用 prod
if [ -z "${SPRING_PROFILE}" ]; then
    if [ "${LOCAL_MODE}" -eq 1 ]; then SPRING_PROFILE="dev"; else SPRING_PROFILE="prod"; fi
fi

# Nacos 启动参数来自 OMP 依赖通道或受控生成的 conf/nacos.params。
# 这里传递的是平台密文，明文只在 JVM 内由 cwop-commons 解开。
NACOS_PARAMS_FILE="${APP_CONF_DIR}/nacos.params"
test -f "${NACOS_PARAMS_FILE}" && . "${NACOS_PARAMS_FILE}"
NACOS_SERVER="${CW_NACOS_SERVER:-${INNER_NACOS_SERVER:-${CER_NACOS_SERVER:-}}}"
NACOS_USERNAME="${CW_NACOS_USERNAME:-${INNER_NACOS_USERNAME:-${CER_NACOS_USERNAME:-}}}"
NACOS_PASSWORD="${CW_NACOS_PASSWORD:-${INNER_NACOS_PASSWORD:-${CER_NACOS_PASSWORD:-}}}"
NACOS_NAMESPACE="${CW_NACOS_NAMESPACE:-${INNER_NACOS_NAMESPACE:-${CER_NACOS_NAMESPACE:-}}}"
######### END

######### Java 命令检查
JAVACMD=$(resolve_java17)
######### END

######### CLASSPATH：conf 排在 lib 之前，所以 conf 里的配置优先于 jar 内的同名资源
if [[ "$(uname -s)" == "Darwin" ]]; then
    for jar in "${APP_HOME}"/lib/*.jar; do
        if [ -z "${CW_CLASSPATH}" ]; then
            CW_CLASSPATH="${jar}"
        else
            CW_CLASSPATH="${CW_CLASSPATH}:${jar}"
        fi
    done
    CW_CLASSPATH=".:${APP_CONF_DIR}:${CW_CLASSPATH}"
else
    CW_CLASSPATH=".:${APP_CONF_DIR}:${APP_HOME}/lib/*"
fi
######### END

######### JVM 参数
JVM_OPTS="
 -server
 -XX:+UseG1GC
 -XX:MaxGCPauseMillis=200
 -XX:MaxMetaspaceSize=256m
 -XX:+HeapDumpOnOutOfMemoryError
 -XX:HeapDumpPath=${APP_LOG_DIR}/java_heapdump.hprof
 -XX:+ExitOnOutOfMemoryError
 -Dspring.profiles.active=${SPRING_PROFILE}
 -Dfile.encoding=UTF-8
 -DcwLogRootPath=${APP_LOG_DIR}
 ${SW_OPTS}
 ${OTHER_OPTS}
"
# 堆大小：部署时由 ${CW_JVM_HEAP_SIZE} 占位符注入（部署工具会替换成如 2g）。
# 未经部署工具替换时该变量为空，直接拼进命令行会变成裸的 -Xms 导致 JVM 起不来，
# 所以为空时整段不加，交给 JVM 默认值。
HEAP_SIZE="${ENV_JVM_HEAP_SIZE:-${OMP_JVM_HEAP_SIZE:-${INNER_JVM_HEAP_SIZE_MIN}}}"
if [ -n "${HEAP_SIZE}" ]; then
    JVM_OPTS="${JVM_OPTS} -Xms${HEAP_SIZE} -Xmx${OMP_JVM_HEAP_SIZE:-${INNER_JVM_HEAP_SIZE_MAX:-${HEAP_SIZE}}}"
fi
[ -n "${INNER_SERVICE_PORT}" ]   && JVM_OPTS="${JVM_OPTS} -Dserver.port=${INNER_SERVICE_PORT}"
[ -n "${INNER_METRICS_PORT}" ]    && JVM_OPTS="${JVM_OPTS} -DcwMetricsPort=${INNER_METRICS_PORT}"
[ -n "${INNER_XXLJOBEXE_PORT}" ]  && JVM_OPTS="${JVM_OPTS} -DcwXxlJobExecutorPort=${INNER_XXLJOBEXE_PORT}"
if [ -n "${NACOS_SERVER}" ]; then
    if [ -z "${NACOS_USERNAME}" ] || [ -z "${NACOS_PASSWORD}" ] || [ -z "${NACOS_NAMESPACE}" ]; then
        echo "Nacos bootstrap parameters are incomplete"
        exit 1
    fi
    JVM_OPTS="${JVM_OPTS} -DcwNacosServer=${NACOS_SERVER}"
    JVM_OPTS="${JVM_OPTS} -DcwNacosUserName=${NACOS_USERNAME}"
    JVM_OPTS="${JVM_OPTS} -DcwNacosPassword=${NACOS_PASSWORD}"
    JVM_OPTS="${JVM_OPTS} -DcwNacosNamespace=${NACOS_NAMESPACE}"
fi
######### END

######### 服务状态检查
alive() {
    PID=$(cat "${APP_PID_FILE}" 2>/dev/null)
    PS_PID=$(ps -ef | grep "${MAIN_CLASS}" | grep -v grep | awk '{print $2}')
    ps -p "${PID}" &>/dev/null
    RETVAL=$?
    ps -p "${PS_PID}" &>/dev/null
    PS_RETVAL=$?
    if [ ${RETVAL} -eq 0 ]; then
        echo 0
    elif [ ${PS_RETVAL} -eq 0 ]; then
        echo 0
        echo "${PS_PID}" >"${APP_PID_FILE}"
    else
        echo ${RETVAL}
    fi
}
######### END

status() {
    if [ "$(alive)" -eq 0 ]; then
        echo "${APP_NAME} [running]" | column -t
    else
        echo "${APP_NAME} [not running]" | column -t
    fi
}

######### 启动
start_inside() {
    if [ "$(alive)" -eq 0 ]; then
        echo "${APP_NAME} [running]" | column -t
    elif [ "${FOREGROUND}" -eq 1 ]; then
        echo "前台启动 profile=${SPRING_PROFILE} workdir=${APP_HOME}"
        cd "${APP_HOME}" && exec ${JAVACMD} ${JVM_OPTS} -classpath "${CW_CLASSPATH}" ${MAIN_CLASS}
    else
        cd "${APP_HOME}"
        nohup ${JAVACMD} ${JVM_OPTS} -classpath "${CW_CLASSPATH}" ${MAIN_CLASS} \
            1>/dev/null 2>"${APP_LOG_DIR}/start.log" &
        echo $! >"${APP_PID_FILE}"
        sleep 1
        status
        echo "日志：${APP_LOG_DIR}/start.log"
    fi
}

start() {
    # 本地模式不涉及部署用户切换，直接起
    if [ "${LOCAL_MODE}" -eq 1 ]; then
        start_inside
        return
    fi
    user_id=$(id -u)
    if [ ${user_id} -eq 0 ] && [ -n "${INNER_RUN_USER}" ]; then
        id "${INNER_RUN_USER}" &>/dev/null || useradd "${INNER_RUN_USER}"
        chown -R "${INNER_RUN_USER}" "${APP_HOME}" &>/dev/null
        chown -R "${INNER_RUN_USER}" "${APP_LOG_DIR}" &>/dev/null
        # 切用户后重跑本脚本；只有明确使用 -f 时才传前台标记。
        foreground_arg=""
        [ "${FOREGROUND}" -eq 1 ] && foreground_arg=" -f"
        su -m "${INNER_RUN_USER}" -s /bin/bash \
            -c "\"${THIS_SCRIPT}\" start_inside${foreground_arg}"
    else
        start_inside
    fi
}

######### 停止
stop() {
    PID=$(cat "${APP_PID_FILE}" 2>/dev/null)
    if [ -z "${PID}" ]; then
        PID=$(ps -ef | grep "${MAIN_CLASS}" | grep -v grep | awk '{print $2}')
    fi
    kill ${PID} &>/dev/null
    sleep 2
    if [ "$(alive)" -eq 0 ]; then
        kill -9 ${PID} &>/dev/null
    fi
    sleep 1
    status
    rm -f "${APP_PID_FILE}"
}

main() {
    case "$1" in
    start) start ;;
    start_inside) start_inside ;;
    stop) stop ;;
    restart)
        stop
        start
        ;;
    status) status ;;
    *) echo "usage: $0 [-l] [start [-f]|stop|restart|status]" ;;
    esac
}

main "${ACTION}"
