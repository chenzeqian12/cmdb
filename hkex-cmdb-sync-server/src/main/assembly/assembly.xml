<assembly
        xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <!--
      部署包结构（与 docc / doop-server 一致）：

        hkexCmdbSync/
        ├── bin/hkexCmdbSync      启停脚本（conf 挂 classpath）
        ├── conf/                 配置，改完重启生效，不用重新打包
        ├── lib/                  主 jar + 全部 runtime 依赖
        ├── logs/  pid/           运行时生成
        └── README.md
    -->
    <id>pkg</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <baseDirectory>hkexCmdbSync</baseDirectory>
    <includeBaseDirectory>true</includeBaseDirectory>

    <fileSets>
        <!-- 工程根目录的 README 放到包根，方便现场直接看 -->
        <fileSet>
            <directory>${project.basedir}/..</directory>
            <outputDirectory>./</outputDirectory>
            <includes>
                <include>README.md</include>
            </includes>
            <fileMode>644</fileMode>
        </fileSet>

        <!--
          配置：只带真实配置，.example 模板不带。
          刻意不开 filtered —— 这些 properties 里的 ${XXX:} 是留给 Spring 解析的占位符，
          开了 Maven 过滤会被当成 Maven 属性处理掉。
        -->
        <fileSet>
            <directory>conf</directory>
            <outputDirectory>conf</outputDirectory>
            <excludes>
                <exclude>*.example</exclude>
            </excludes>
            <fileMode>644</fileMode>
            <directoryMode>755</directoryMode>
        </fileSet>

        <!-- 启停脚本 -->
        <fileSet>
            <directory>bin</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>755</fileMode>
            <directoryMode>755</directoryMode>
        </fileSet>
    </fileSets>

    <dependencySets>
        <!-- 主 jar，按制品命名约定改名 -->
        <dependencySet>
            <useProjectArtifact>true</useProjectArtifact>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
            <includes>
                <include>${groupId}:${artifactId}</include>
            </includes>
            <outputFileNameMapping>${pkg-file-name-mapping}</outputFileNameMapping>
        </dependencySet>

        <!-- 其余 runtime 依赖，原名放进 lib/ -->
        <dependencySet>
            <useProjectArtifact>true</useProjectArtifact>
            <outputDirectory>lib</outputDirectory>
            <scope>runtime</scope>
            <excludes>
                <exclude>${groupId}:${artifactId}</exclude>
            </excludes>
        </dependencySet>
    </dependencySets>
</assembly>
