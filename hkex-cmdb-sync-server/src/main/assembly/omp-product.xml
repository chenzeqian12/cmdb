<assembly
        xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.3 http://maven.apache.org/xsd/assembly-1.1.3.xsd">
    <id>install</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <baseDirectory>${omp.product.name}</baseDirectory>
    <includeBaseDirectory>true</includeBaseDirectory>
    <fileSets>
        <fileSet>
            <directory>${project.basedir}/conf</directory>
            <outputDirectory>${omp.product.name}</outputDirectory>
            <includes>
                <include>hkexCmdbSync.yaml</include>
            </includes>
            <filtered>true</filtered>
            <fileMode>644</fileMode>
        </fileSet>
    </fileSets>
    <files>
        <file>
            <source>${project.basedir}/conf/omp-product.yaml</source>
            <outputDirectory>/</outputDirectory>
            <destName>${omp.product.name}.yaml</destName>
            <filtered>true</filtered>
            <fileMode>644</fileMode>
        </file>
        <file>
            <source>${project.build.directory}/${final-tar-name}.tar.gz</source>
            <outputDirectory>/</outputDirectory>
            <fileMode>644</fileMode>
        </file>
    </files>
</assembly>
