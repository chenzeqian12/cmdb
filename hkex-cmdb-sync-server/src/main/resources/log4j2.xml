<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志配置。随 jar 发布（src/main/resources/log4j2.xml），在 classpath 上自动生效。

  为什么必须有这个文件：
    后台启动时 stdout/stderr 被重定向到 logs/app.out.log、logs/app.err.log，
    若没有文件 appender，日志只走 console —— 滚动归档、ERROR 单独一份这些都没了。

  日志目录取值顺序（顺序不能反，现场踩过）：
    1. cwLogRootPath —— 启动脚本注入，值就是 OMP 声明的 log_dir（/data/logs/hkexCmdbSync）。
    2. LOG_PATH      —— Spring Boot 由配置项 logging.file.path 生成的系统属性。
    3. logs/         —— 相对 CWD，只在 IDE 里直接跑、两个属性都没有时用。

  为什么 cwLogRootPath 必须优先：Nacos 里 logging.file.path 配的相对路径（如 "./logs"）会被
  Spring Boot 变成 LOG_PATH=./logs，按进程工作目录解析就是安装目录 /data/app/hkexCmdbSync/logs。
  结果是服务日志写进安装目录，而运维采集、交付文档、排障习惯看的是 OMP 的 log_dir，
  表现成「服务明明在跑却没有任何日志」。日志目录以 OMP 的 log_dir 为准，Nacos 那个值只当兜底。
-->
<Configuration status="WARN">

    <Properties>
        <!-- OMP 的 log_dir 优先；Nacos 的 logging.file.path 仅在缺少前者时兜底 -->
        <Property name="LOG_HOME">${sys:cwLogRootPath:-${sys:LOG_PATH:-logs}}</Property>
        <Property name="LOG_PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </Console>

        <RollingFile name="File"
                     fileName="${LOG_HOME}/hkex-cmdb-sync.log"
                     filePattern="${LOG_HOME}/hkex-cmdb-sync-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <!-- 保留 30 天，够排查到上一次全量同步 -->
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>

        <!-- 错误单独一份，便于告警和快速定位 -->
        <RollingFile name="ErrorFile"
                     fileName="${LOG_HOME}/hkex-cmdb-sync-error.log"
                     filePattern="${LOG_HOME}/hkex-cmdb-sync-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${LOG_PATTERN}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- DOUC 注册中心 URL 包含解密后的密码，不能写入日志。 -->
        <Logger name="org.apache.dubbo" level="OFF"/>
        <Logger name="com.alibaba.nacos" level="OFF"/>
        <Logger name="com.cloudwise.utils" level="OFF"/>
        <!-- 业务日志：文件全量留一份，控制台同步输出便于前台调试 -->
        <Logger name="com.cloudwise.cmdb" level="INFO" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="ErrorFile"/>
        </Logger>

        <!-- 依赖框架的日志只落文件，避免控制台被刷屏 -->
        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>

</Configuration>
